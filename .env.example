# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# Postgres and RabbitMQ, both required.
DATABASE_DSN=postgres://reporting:reporting@localhost:5432/reporting?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
GRPC_PORT=9090
PROBE_PORT=8080
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Identity, asked who is an officer.
IDENTITY_GRPC_ADDR=localhost:9091

# The local group ids or identity provider group names whose members work
# cases. Empty means nobody can open a case.
REPORTING_OFFICER_GROUPS=Privacy Officers

# Days allowed from discovery per notice recipient.
REPORTING_NOTICE_DAYS_AFFECTED=60
REPORTING_NOTICE_DAYS_REGULATOR=60
REPORTING_NOTICE_DAYS_MEDIA=60
REPORTING_NOTICE_DAYS_OTHER=60

# Service-to-service authentication. Local runs only: every caller is
# trusted. A cluster sets WORKLOAD_OIDC_ISSUER and
# WORKLOAD_ALLOWED_SERVICEACCOUNTS instead.
WORKLOAD_AUTH=disabled
